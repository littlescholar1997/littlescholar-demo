{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "little-scholar-admin",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-24",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {"directory": "../dist", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none"},
